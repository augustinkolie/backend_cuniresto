# ─── Serveur
NODE_ENV=development
PORT=4100
API_URL=http://localhost:4100
WEB_URL=http://localhost:3100

# ─── Base de données (docker compose)
DATABASE_URL=postgresql://braise:braise@localhost:5433/maison_braise?schema=public
REDIS_URL=redis://localhost:6379

# ─── Authentification (générer avec : openssl rand -base64 48)
JWT_ACCESS_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-min
JWT_REFRESH_SECRET=remplacer-par-une-autre-longue-chaine-aleatoire-de-32-car
GOOGLE_CLIENT_ID=

# ─── E-mails (mailpit en développement : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Maison Braise <no-reply@maisonbraise.gn>"
ADMIN_NOTIFICATION_EMAIL=contact@maisonbraise.gn

# ─── Médias
UPLOAD_DIR=uploads

# ─── Paiement : Orange Money Guinée
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_API_URL=https://api.orange.com
# Bac à sable : /orange-money-webpay/dev/v1 et OM_CURRENCY=OUV
OM_WEBPAY_PATH=/orange-money-webpay/gn/v1
OM_CURRENCY=GNF
# Secret partagé ajouté à l'URL de notification pour authentifier les webhooks Orange Money
OM_WEBHOOK_SECRET=

# ─── Paiement : carte bancaire (Stripe, GNF est une devise sans décimales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Paiement : PayPal (PayPal ne gère pas le GNF : conversion vers PAYPAL_CURRENCY)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=EUR
# Nombre de GNF pour 1 unité de PAYPAL_CURRENCY
PAYPAL_GNF_RATE=9500

# ─── Appels audio/vidéo : serveur TURN (recommandé en production, sinon STUN public)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Revalidation du cache Next.js après modification de la carte ou des contenus
REVALIDATE_SECRET=dev-revalidate-secret-change-me

# ─── Assistant (optionnel) : Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
